# ==============================================================================
# AI JOB SEARCH - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and fill in your private keys.
# NEVER commit .env to version control! (.env is protected by .gitignore)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Gemini API (Free Tier via Google AI Studio)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/
# Used for tailoring motivation letters, STAR interview coaching, and review.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 2. Gmail Alerts Reader (Read-Only Least-Privilege Scope)
# ------------------------------------------------------------------------------
# OAuth2 client credentials from Google Cloud Console.
# Required Scope: https://www.googleapis.com/auth/gmail.readonly (restricted to "Job Alerts" label)
GMAIL_CREDENTIALS_PATH=gmail_sync/credentials.json
GMAIL_TOKEN_PATH=gmail_sync/token.json
GMAIL_LABEL=Job Alerts

# ------------------------------------------------------------------------------
# 3. Notification Dispatcher (Choose ntfy.sh or Telegram)
# ------------------------------------------------------------------------------
# Preferred: ntfy.sh (100% free, zero authentication required, instant mobile push)
NOTIFICATION_CHANNEL=ntfy
NTFY_TOPIC=amine_jobs_alert_private_channel

# Alternative: Telegram Bot (Free)
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ------------------------------------------------------------------------------
# 4. Pipeline Parameters & Ranking Thresholds
# ------------------------------------------------------------------------------
MIN_MATCH_SCORE=70
TARGET_CITY=Fès
TARGET_COUNTRY=Morocco
ENABLE_REMOTE_ONLY=false
ENABLE_AUTOMATIC_DRAFTING=true
